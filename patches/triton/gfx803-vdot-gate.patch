+bool TargetFeatures::supportsVDot() const {
+  // GCN3 is the one family triton accepts whose ISA predates v_dot. Every other
+  // family keeps the packed cells, so no other target's lowering changes.
+  switch (getISAFamily()) {
+  case ISAFamily::Unknown:
+  case ISAFamily::GCN3:
+    return false;
+  default:
+    return true;
+  }
