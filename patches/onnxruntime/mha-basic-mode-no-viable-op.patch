   inline static size_t GetWorkspaceNumBytes(const RocmAttentionParameters* attn) {
-    return GetAttentionWorkspaceSize(
+    size_t bytes = GetAttentionWorkspaceSize(
         sizeof(T),
         attn->batch_size,
         attn->num_heads,
         attn->head_size,
         attn->sequence_length,
         attn->total_sequence_length);
+    // MHA_BASIC_MODE_TRANSPOSE_PATCH
+    // BSNH_BLNH_BLNH_NONE_NONE_NONE_NONE ("MHA basic", see the mode table at the
+    // top of this file) is the plain three-separate-tensor MultiHeadAttention
+    // call: Q, K, V arrive unpermuted (BSNH/BLNH), exactly as documented for
+    // "In QKV projection (prior to this pipeline)" above -- except here nothing
+    // upstream did that projection/permute, because there's no fused QKV
+    // projection to do it. GemmSoftmaxGemmPermuteGenericPipeline::Gemm1/Gemm2
+    // assume BNSH-strided buffers, so this mode needs its own permute step
+    // before those GEMMs run. Reserve room for three transposed (BNSH) copies
+    // of Q, K, V, appended after the existing gemm1_out/softmax_out/gemm2_out
+    // region so it can never alias it.
+    if (attn->mode == BSNH_BLNH_BLNH_NONE_NONE_NONE_NONE) {
+      bytes += GetQkvTransposeExtraBytes(attn);
+    }
+    return bytes;
+  }
+
+  inline static size_t GetQkvTransposeExtraBytes(const RocmAttentionParameters* attn) {
+    size_t elems = static_cast<size_t>(attn->batch_size) * attn->num_heads *
+                   (static_cast<size_t>(attn->sequence_length) * attn->head_size +
+                    static_cast<size_t>(attn->total_sequence_length) * attn->head_size +
+                    static_cast<size_t>(attn->total_sequence_length) * attn->v_head_size);
+    return sizeof(T) * elems;
+  }
+
+  // Transposes Q, K, V from BSNH/BLNH (unpermuted, as delivered by the plain
+  // MultiHeadAttention op) into BNSH, writing into the tail of workspace_buffer
+  // reserved by GetQkvTransposeExtraBytes above. Returns a params copy pointing
+  // at the transposed buffers; all other fields are identical to the input.
+  // GemmSoftmaxGemmPermuteParams has no owned resources, so this shallow copy
+  // is safe -- see its definition above.
+  static Status TransposeQkvForBasicMha(const GemmSoftmaxGemmPermuteParams<T>* params,
+                                        GemmSoftmaxGemmPermuteParams<T>& out_params) {
+    const auto* attn = params->attention;
+    size_t base_bytes = GetAttentionWorkspaceSize(
+        sizeof(T), attn->batch_size, attn->num_heads, attn->head_size,
+        attn->sequence_length, attn->total_sequence_length);
+    T* transpose_region = reinterpret_cast<T*>(
+        reinterpret_cast<char*>(params->workspace_buffer) + base_bytes);
+
+    size_t q_elems = static_cast<size_t>(attn->batch_size) * attn->num_heads *
+                     attn->sequence_length * attn->head_size;
+    size_t k_elems = static_cast<size_t>(attn->batch_size) * attn->num_heads *
+                     attn->total_sequence_length * attn->head_size;
+
+    T* q_bnsh = transpose_region;
+    T* k_bnsh = q_bnsh + q_elems;
+    T* v_bnsh = k_bnsh + k_elems;
+
+    int max_threads = params->device_prop->maxThreadsPerBlock;
+    hipStream_t stream = params->StreamHandle();
+
+    // matrix_num=1: no packed-QKV chunking, just a plain BSNH -> BNSH permute.
+    ORT_RETURN_IF_ERROR(LaunchTransQkv(
+        stream, /*matrix_num=*/1, attn->sequence_length, attn->batch_size,
+        attn->head_size, attn->num_heads, max_threads, /*reversed_bs=*/false,
+        params->q_buffer, q_bnsh));
+    ORT_RETURN_IF_ERROR(LaunchTransQkv(
+        stream, /*matrix_num=*/1, attn->total_sequence_length, attn->batch_size,
+        attn->head_size, attn->num_heads, max_threads, /*reversed_bs=*/false,
+        params->k_buffer, k_bnsh));
+    ORT_RETURN_IF_ERROR(LaunchTransQkv(
+        stream, /*matrix_num=*/1, attn->total_sequence_length, attn->batch_size,
+        attn->v_head_size, attn->num_heads, max_threads, /*reversed_bs=*/false,
+        params->v_buffer, v_bnsh));
+
+    out_params = *params;
+    out_params.q_buffer = q_bnsh;
+    out_params.k_buffer = k_bnsh;
+    out_params.v_buffer = v_bnsh;
+    return Status::OK();
   }
 
