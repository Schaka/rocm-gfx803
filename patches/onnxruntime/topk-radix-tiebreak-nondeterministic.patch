+// bit-identical input -- confirmed via a non-invasive host-side dump (no
+// extra sync/copy, so it doesn't perturb timing the way instrumentation
+// did earlier): BeamSearchTest.GptBeamSearchFp32_DisableFastTopK failed
+// ~50% of isolated single-test runs, always on an exact-tie decode step.
+// Not upstream floating-point noise -- the differing values printed were
+// literal 0 at %.9g precision, not near-zero.
+//
+// cub::DeviceRadixSort (this file's other fallback, for K > BT*16) is a
+// different hipCUB code path (device-wide, not block-level primitives) and
+// would sidestep the same defect, but it requires a real CudaKernel* for
+// scratch allocation via kernel->GetScratchBuffer -- and the beam search
+// caller (generation_device_helper.cc) deliberately passes kernel=nullptr,
+// documented inline: "We limit number of beams in BeamSearchParameters, so
+// K <= 256 and use NULL here", banking on always landing in RadixTopK.
+// Confirmed by crash: forcing that path with kernel=nullptr segfaults in
+// GetScratchBuffer.
+//
+// BitonicTopK (this file's other alternative, no hipCUB dependency) only
+// works when aligned_dimension <= blockDim -- its sort/merge phases index
+// via tid/(tid<<1) pairs that don't cover positions beyond what blockDim
+// threads can reach in one pass. Not safely extensible to large dimension
+// (e.g. this test's 4000) without rewriting the compare-exchange network to
+// handle multiple elements per thread throughout -- out of scope here.
+//
+// This kernel avoids all three problems: K sequential block-wide argmax
+// passes, entirely hand-written (no hipCUB block primitives at all), no
+// CudaKernel dependency, and no O(dimension) shared memory -- the "already
+// selected" check scans the K selected indices found so far (K is small by
+// construction: this replaces RadixTopK, gated the same way, K <= BT*16),
+// not a dimension-sized flag array. Safe for the vocab sizes real beam
+// search sees (shared memory scales with blockDim and K only).
+//
+// Ties are broken by lowest index, matching IS_SMALLER/BIGGER's existing
+// convention elsewhere in this file (see their `.val` tie-break clause) --
+// deterministic and reproducible given identical input, unlike the kernel
+// this replaces.
+template <typename T>
+__global__ void SafeSmallKTopK(const T* X, T* V, int64_t* I, const TArray<int64_t> elem_nums, size_t size,
+                               int32_t axis, int64_t K, int64_t largest, int64_t sorted, int64_t dimension,
+                               T type_min, T type_max) {
+  extern __shared__ char shared_mem[];
+  auto best_val = (T*)shared_mem;
+  auto best_idx = (int64_t*)(best_val + blockDim.x);
+  auto selected = (int64_t*)(best_idx + blockDim.x);
+
+  auto tid = threadIdx.x;
+  auto bid = blockIdx.x;
+  auto bdim = static_cast<int64_t>(blockDim.x);
+  auto mid_dim = axis == size - 1 ? 1 : elem_nums[axis + 1];
+  auto left_dim = bid / mid_dim * elem_nums[axis];
+  auto right_dim = axis == size - 1 ? 0 : bid % elem_nums[axis + 1];
+
+  for (int64_t k = 0; k < K; ++k) {
+    T local_best_val = 1 == largest ? type_min : type_max;
+    int64_t local_best_idx = -1;
+    for (int64_t i = tid; i < dimension; i += bdim) {
+      bool already_selected = false;
+      for (int64_t s = 0; s < k; ++s) {
+        if (selected[s] == i) {
+          already_selected = true;
+          break;
+        }
+      }
+      if (already_selected) continue;
+      T x = X[FROM(i)];
+      bool better = local_best_idx < 0 ||
+                    (1 == largest ? (x > local_best_val || (x == local_best_val && i < local_best_idx))
+                                  : (x < local_best_val || (x == local_best_val && i < local_best_idx)));
+      if (better) {
+        local_best_val = x;
+        local_best_idx = i;
+      }
+    }
+    best_val[tid] = local_best_val;
+    best_idx[tid] = local_best_idx;
+    __syncthreads();
+    for (int64_t stride = bdim / 2; stride > 0; stride >>= 1) {
+      if (tid < stride) {
+        auto other_val = best_val[tid + stride];
+        auto other_idx = best_idx[tid + stride];
+        bool other_better;
+        if (best_idx[tid] < 0) {
+          other_better = other_idx >= 0;
+        } else if (other_idx < 0) {
+          other_better = false;
+        } else if (1 == largest) {
+          other_better = other_val > best_val[tid] || (other_val == best_val[tid] && other_idx < best_idx[tid]);
+        } else {
+          other_better = other_val < best_val[tid] || (other_val == best_val[tid] && other_idx < best_idx[tid]);
+        }
+        if (other_better) {
+          best_val[tid] = other_val;
+          best_idx[tid] = other_idx;
+        }
+      }
+      __syncthreads();
+    }
+    if (0 == tid) {
+      selected[k] = best_idx[0];
+      auto to = TO(k);
+      V[to] = best_val[0];
+      I[to] = best_idx[0];
+    }
+    __syncthreads();
+  }
+
+  if (0 == sorted && 0 == tid) {
+    // K is small (this replaces RadixTopK, same K <= BT*16 gate) -- a plain
+    // insertion sort by ascending index, done by one thread, is cheap enough.
+    for (int64_t a = 1; a < K; ++a) {
+      auto to_a = TO(a);
+      T val_a = V[to_a];
+      int64_t idx_a = I[to_a];
+      int64_t b = a - 1;
+      while (b >= 0 && I[TO(b)] > idx_a) {
+        V[TO(b + 1)] = V[TO(b)];
+        I[TO(b + 1)] = I[TO(b)];
+        --b;
+      }
+      V[TO(b + 1)] = val_a;
+      I[TO(b + 1)] = idx_a;
+    }
+  }
+}
+#endif
