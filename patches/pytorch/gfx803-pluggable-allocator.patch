+def _maybe_install_gfx803_pluggable_allocator():
+    """gfx803: optionally swap in a hipMalloc-backed allocator (experimental).
+
+    Enabled only when GFX803_PLUGGABLE_ALLOCATOR is set at runtime, off by
+    default. On gfx803 the default caching allocator's block layout can corrupt
+    the next kernel's access after a GEMM (silent NaN/garbage). A pluggable
+    allocator whose raw allocations come from plain hipMalloc avoids that layout on
+    the stacks where it reproduces. Experimental: stats are reported (allocation
+    count and bytes), the rest of the allocator API (graphs, IPC, snapshots) is
+    best-effort no-ops, and per-allocator overhead differs from the caching
+    allocator. The env value is either a path to the allocator .so, or any
+    truthy value to use the default /opt/rocm/lib/libgfx803_pluggable.so.
+    """
+    global _gfx803_pluggable_attempted
+    if _gfx803_pluggable_attempted:
+        return
+    _gfx803_pluggable_attempted = True
+    setting = os.environ.get("GFX803_PLUGGABLE_ALLOCATOR")
+    if not setting:
+        return
+    so = "/opt/rocm/lib/libgfx803_pluggable.so"
+    if os.path.exists(setting):
+        so = setting
+    if not os.path.exists(so):
+        print(
+            f"[gfx803] GFX803_PLUGGABLE_ALLOCATOR set but {so} not found; "
+            "keeping the default allocator",
+            flush=True,
+        )
+        return
+    try:
+        from torch.cuda.memory import CUDAPluggableAllocator
+
+        alloc = CUDAPluggableAllocator(so, "gfx803_alloc", "gfx803_free")
+        torch.cuda.memory.change_current_allocator(alloc)
+        print(f"[gfx803] pluggable hipMalloc allocator active ({so})", flush=True)
+    except Exception as e:
+        print(
+            f"[gfx803] pluggable allocator install failed ({e}); "
+            "keeping the default allocator",
+            flush=True,
+        )
+
