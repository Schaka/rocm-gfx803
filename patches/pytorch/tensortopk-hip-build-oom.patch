+  # TENSORTOPK_HIP_MEMORY_WORKAROUND_PATCH
+  # TensorTopK.hip's CUB radix-sort instantiations push clang's AMDGPU
+  # backend to ~20GB RSS at -O3, OOM-killing constrained build hosts. -O1
+  # for this one file only; the trailing flag wins over the default -O3.
+  # Must be set here, in torch_hip's own directory scope -- source
+  # properties don't propagate from aten/src/ATen/CMakeLists.txt, where
+  # ATen_HIP_SRCS/Caffe2_HIP_SRCS is only assembled, not where the target
+  # consuming it is actually created.
+  set_source_files_properties(${TORCH_ROOT}/aten/src/ATen/native/hip/TensorTopK.hip
+    PROPERTIES COMPILE_OPTIONS "-O1")
 endif()
 
