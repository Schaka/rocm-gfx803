+// ================================================================================================
+// gfx7/gfx8 only: publish a PM4 ACQUIRE_MEM (TC invalidate + TC writeback) in its own AQL ring
+// slot immediately ahead of a client kernel dispatch.
+//
+// On CIK the shader TC is not dropped at a dispatch boundary, and the AQL
+// SCACQUIRE/SCRELEASE scope bits do not drop it either: a kernel reading a VA
+// whose contents an earlier kernel overwrote can be served the pre-overwrite
+// bytes even though the new data is provably already in VRAM (measured on
+// gfx803 by walking the process page tables and reading the physical page from
+// the driver while the reader still saw the old bytes). ROCm expresses
+// cross-dispatch coherence only through those scope bits, so every consumer
+// that recycles a VA -- a caching allocator above all -- can read stale data.
+// ACQUIRE_MEM with TC_ACTION_ENA|TC_WB_ACTION_ENA is the only packet on this
+// ISA that clears the condition, and ROCr already emits exactly that shape when
+// it loads a code object (GpuAgent::InvalidateCodeCaches).
+//
+// The same slot serves both directions of the problem, because the packet does
+// both: TC_ACTION_ENA drops read lines that a previous kernel left behind, and
+// TC_WB_ACTION_ENA pushes this kernel's dirty lines out. A copy engine (or the
+// host, through a staging buffer the copy engine filled) reads physical memory
+// and never looks at the shader TC, so it needs the writeback half: without it
+// an SDMA read of a buffer that a compute kernel just wrote copies the
+// pre-write bytes -- a correct result on the GPU, garbage in the host copy.
+//
+// Slot layout mirrors ROCr's gfx8 ExecutePM4 protocol: raw PM4 inside a 64-byte
+// AQL slot, terminated by a RELEASE_MEM whose EVENT_INDEX(AQL) retires the
+// slot, with dword 0 written last so the CP never sees a half-built packet.
+// No doorbell of its own: the caller must submit something after it (a dispatch,
+// or the barrier packet releaseGpuMemoryFence() emits) which rings the doorbell
+// at a higher ring index and so commits this slot too.
+bool VirtualGPU::insertTcFence() {
+  if (!CLR_GFX8_TC_INVALIDATE || dev().isa().versionMajor() > 8) return true;
+
+  constexpr uint32_t kSlotDwords = 16;
+  // PM4 header: type 3, count = size_dw - 2, shader_type 0 for gfx8.
+  constexpr uint32_t kPm4Type3 = 3u << 30;
+  constexpr uint32_t kAcquireMemHdr = kPm4Type3 | ((7u - 2u) << 16) | (0x58u << 8);
+  constexpr uint32_t kNopHdr = kPm4Type3 | ((2u - 2u) << 16) | (0x10u << 8);
+  constexpr uint32_t kReleaseMemHdr = kPm4Type3 | ((7u - 2u) << 16) | (0x49u << 8);
+  constexpr uint32_t kTcWbActionEna = 1u << 18;
+  constexpr uint32_t kTcActionEna = 1u << 23;
+  constexpr uint32_t kReleaseEventIndexAql = 7u << 8;
+
+  uint32_t slot[kSlotDwords] = {0};
+  slot[0] = kAcquireMemHdr;
+  slot[1] = kTcActionEna | kTcWbActionEna;
+  slot[2] = 0xFFFFFFFFu;  // COHER_SIZE, in 256-byte granules
+  slot[3] = 0xFFu;        // COHER_SIZE_HI -> whole address space
+  slot[7] = kNopHdr;
+  slot[9] = kReleaseMemHdr;
+  slot[10] = kReleaseEventIndexAql;
+
+  const uint32_t queueMask = gpu_queue_->size - 1;
+  const uint64_t index = Hsa::queue_add_write_index_screlease(gpu_queue_, 1);
+  WaitForQueueSlot(index, queueMask);
+
+  uint32_t* dst = reinterpret_cast<uint32_t*>(gpu_queue_->base_address) +
+                  ((index & queueMask) * kSlotDwords);
+  for (uint32_t i = 1; i < kSlotDwords; ++i) dst[i] = slot[i];
+  amd::nontemporalStoreFence();
+  packet_store_release(dst, static_cast<uint16_t>(slot[0]),
+                       static_cast<uint16_t>(slot[0] >> 16));
+
+  return true;
+}
