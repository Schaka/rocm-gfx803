+
+	/* GFX803_VA_REUSE_DEFER_PATCH: park the WHOLE object on the deferred
+	 * FIFO: its BOs stay alive and its VA stays reserved. The BO is really
+	 * freed when the entry ages out of the window (fmm_defer_release ->
+	 * fmm_do_release), inside a later FREE call while the GPU is busy -- the
+	 * busy teardown is what clears the stale gfx803 memory-system state.
+	 *
+	 * Three kinds of object are released at once instead. Scratch backing:
+	 * fmm_release_scratch() loops until the tree is empty, so a parked object
+	 * makes it spin forever at process exit. SVM-backed paged memory: it has
+	 * no BO to keep alive, and its teardown below munmaps the pages and drops
+	 * the SVM range reference, which fmm_do_release() does not do. Objects in
+	 * an mmap aperture: fmm_retire_stale_userptrs() releases through here and
+	 * needs the stale registration gone before its caller publishes the new
+	 * object at that address. gfx803's 40-bit GPUVM limit never selects mmap
+	 * apertures (init_svm_apertures), so on gfx803 only scratch bypasses.
+	 */
+	if (!fmm_is_scratch_aperture(ctx->fmm_context, object->start) &&
+	    !object->is_svm_paged &&
+	    aperture->ops != &mmap_aperture_ops) {
+		object->deferred = true;
+		fmm_defer_release(ctx, aperture, object);
+		return 0;
+	}
