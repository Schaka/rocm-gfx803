-    if(!(name == "gfx900" || name == "gfx906" || name == "gfx908"))
+    // RESTORE_GFX803_WINOGRAD_PATCH: gfx803 stays in this list because the GCN3
+    // kernel conv_3x3_wheel_alpha_v3_0b.s serves it, and every newer Winograd
+    // solver in this tree is gated to gfx9 and later.
+    if(!(name == "gfx803" || name == "gfx900" || name == "gfx906" || name == "gfx908"))
