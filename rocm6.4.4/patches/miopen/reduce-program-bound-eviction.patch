+#include <deque>
+#include <unordered_map>
+#include <vector>
 
 // headers from composable kernel, to get consistent ID mapping
 #include <../composable_kernel/composable_kernel/include/utility/data_type_enum.hpp>
 #include <../composable_kernel/composable_kernel/include/utility/reduction_enums.hpp>
 
 MIOPEN_DECLARE_ENV_VAR_BOOL(MIOPEN_DEBUG_DYNAMIC_REDUCTION);
+// tunable bound (gfx803 workaround) -- see reduce-program-bound-eviction.patch
+MIOPEN_DECLARE_ENV_VAR(MIOPEN_DEBUG_REDUCE_PROGRAM_BOUND, unsigned long long, 2);
 
 #define WORKAROUND_MIOPEN_ISSUE_557 1
 
 namespace miopen {
 
+// ---- gfx803 workaround: bound the number of distinct dynamic-reduction code
+// objects resident on a shared Handle at once. See reduce-program-bound-eviction.patch
+// and KERNEL_BUGS.md "The ReduceSum kernel-cache mystery" for why: when a single
+// Handle accumulates many different compiled reduction kernels across a session,
+// some later dispatches on gfx803 intermittently execute wrong (subset of output
+// columns). Keeping only the most-recent-N reduce programs resident makes a
+// dispatch run in the same "isolated" state that is always correct, while still
+// letting repeated same-shape calls hit the cache (no recompile, no perf cliff).
+// thread_local + keyed on &handle: ORT/PyTorch drive one Handle from one thread,
+// which is the only configuration this workaround targets; documented as a
+// limitation (multi-handle-from-multi-thread apps would need real per-Handle
+// state on the Handle object instead).
+namespace detailReduceProgramBound {
+
+struct ReduceProgramRecord
+{
+    std::string program_name;
+    std::string params;
+    std::vector<std::string> network_configs; // every config that used this program
+};
+
+thread_local std::unordered_map<const Handle*, std::deque<ReduceProgramRecord>>
+    g_reduce_recent_programs;
+
+inline void NoteReduceProgram(const Handle& handle,
+                              const std::string& program_name,
+                              const std::string& params,
+                              const std::string& network_config)
+{
+    auto& q = g_reduce_recent_programs[&handle];
+    for(auto it = q.begin(); it != q.end(); ++it)
+    {
+        if(it->program_name == program_name && it->params == params)
+        {
+            if(std::find(it->network_configs.begin(),
+                         it->network_configs.end(),
+                         network_config) == it->network_configs.end())
+                it->network_configs.push_back(network_config);
+            auto rec                         = std::move(*it);
+            q.erase(it);
+            q.push_back(std::move(rec)); // move-to-front (most-recently-used)
+            return;
+        }
+    }
+    ReduceProgramRecord rec;
+    rec.program_name     = program_name;
+    rec.params           = params;
+    rec.network_configs.push_back(network_config);
+    q.push_back(std::move(rec));
+}
+
+inline void EvictReduceProgramsBeyondBound(const Handle& handle, std::size_t bound)
+{
+    if(bound == 0)
+        return;
+    auto& q = g_reduce_recent_programs[&handle];
+    while(q.size() > bound)
+    {
+        auto old = std::move(q.front());
+        q.pop_front();
+        // ClearProgram can release the underlying GPU code object while the
+        // just-launched kernel may still be executing from it, so Finish() first
+        // (the abandoned always-evict patch shipped a use-after-release race by
+        // omitting this). ClearKernels for every config that referenced this
+        // program so no cached Kernel points into the freed code object.
+        handle.Finish();
+        for(const auto& cfg : old.network_configs)
+            handle.ClearKernels("generic_reduce_tensor", cfg);
+        handle.ClearProgram(old.program_name, old.params);
+    }
+}
+
+} // namespace detailReduceProgramBound
+
 enum ReductionMethod_t
 {
     Reduce_DirectThreadWise = 1,
