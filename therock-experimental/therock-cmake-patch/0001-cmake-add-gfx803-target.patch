From 3c92e89618cd14b48069bfe668640f8ba22e960f Mon Sep 17 00:00:00 2001
From: Schaka <jonastanzer@gmail.com>
Date: Tue, 11 Aug 2026 10:45:52 +0200
Subject: [PATCH] cmake: add gfx803 (Polaris) AMDGPU target

Adds a therock_add_amdgpu_target entry for gfx803, modeled on the
existing gfx900 entry (same EXCLUDE_TARGET_PROJECTS reasoning: none of
these ever supported gfx8, same as gfx900's own exclude list plus
rocMLIR, which gfx900 doesn't need to exclude but gfx803 does -- see
ROCm-gfx803's root Dockerfile, which switches off rocMLIR/CK/hipBLASLt
for the same reason on its own hand-rolled build).

This target does not exist on any TheRock branch (confirmed via
git ls-remote across main and every release/therock-* branch) -- pinned
here to an exact main commit SHA specifically to test whether gfx803
restoration is even buildable through TheRock's own orchestration,
following ROCm/clr#269. Not proposed as ready to merge upstream as-is.
---
 cmake/therock_amdgpu_targets.cmake | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/cmake/therock_amdgpu_targets.cmake b/cmake/therock_amdgpu_targets.cmake
index d2db1b38..c11b9eea 100644
--- a/cmake/therock_amdgpu_targets.cmake
+++ b/cmake/therock_amdgpu_targets.cmake
@@ -55,6 +55,21 @@ therock_add_amdgpu_target(gfx900 "Vega 10 / MI25" FAMILY dgpu-all gfx900-dgpu
     rocprofiler-compute # https://github.com/ROCm/TheRock/issues/2892
 )

+# gfx803 (requires patches/gfx803 applied to rocm-systems/rocm-libraries --
+# see therock-experimental/README.md in ROCm/rocm-gfx803 for the
+# experimental pipeline this target is exercised from; not part of
+# mainline TheRock)
+therock_add_amdgpu_target(gfx803 "Polaris / RX 550-590" FAMILY dgpu-all gfx803-dgpu
+  EXCLUDE_TARGET_PROJECTS
+    hipBLASLt # never supported gfx8
+    hipSPARSELt # never supported gfx8
+    composable_kernel # never supported gfx8
+    rocWMMA # never supported gfx8
+    hipTensor # never supported gfx8
+    rocprofiler-compute # never supported gfx8
+    rocMLIR # never supported gfx8
+)
+
 # gfx90c
 therock_add_amdgpu_target(gfx90c "AMD Renoir/Lucienne/Cezanne iGPU" FAMILY igpu-all gfx90c-igpu
   EXCLUDE_TARGET_PROJECTS
--
2.55.0
