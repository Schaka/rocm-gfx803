       } else {
         result = blitMgr().readBuffer(*devMem, dst, origin, size, cmd.isEntireMemory(),
@@ -3216,7 +3234,15 @@ bool VirtualGPU::copyMemory(cl_command_type type, amd::Memory& srcMem, amd::Memo
         realSize.c[0] *= elemSize;
       }
 
-      result = blitMgr().copyBuffer(*srcDevMem, *dstDevMem, realSrcOrigin, realDstOrigin, realSize,
-                                    entire, copyMetadata);
+      if (dstDevMem->isHostMemDirectAccess()) {
+        // GFX803: same as submitReadMemory -- a D2H copy into a
