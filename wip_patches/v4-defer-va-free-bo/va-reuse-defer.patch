-	 * free the BO before unmapping the pages.
+	/* GFX803_VA_REUSE_DEFER_PATCH: this object's release was already parked
+	 * on the defer FIFO (BOs freed, handles scrubbed, VA still reserved).
+	 * A second release of the same address must be a no-op -- re-issuing
+	 * FREE_MEMORY_OF_GPU on the stale handle ids could free a handle KFD
+	 * has since recycled to a different, live BO (observed as intermittent
+	 * mid-run GPU page faults, "Page not present").
+	 */
+	if (object->deferred) {
+		pthread_mutex_unlock(&aperture->fmm_mutex);
+		return 0;
+	}
+
+	/* GFX803 VA-recycling workaround: free the KFD BO + pages immediately,
+	 * but do NOT return the VA to the aperture free-list yet. It is parked
+	 * on the deferred FIFO and only released after FMM_REUSE_DELAY_ALLOCS
+	 * further allocations, so a freed address is never handed straight back
+	 * (mirrors the proven ring-16 result). Bounded -- the flush eventually
+	 * releases every parked area, so nothing leaks.
 	 */
 	for (i = 0; i < object->handle_num; i++) {
 		args.handle = object->handles[i];
@@ -2016,8 +2118,29 @@ static int __fmm_release(vm_object_t *object, manageable_aperture_t *aperture)
 	if (ret)
 		goto err_free_mem_failed;
 
-	aperture_release_area(aperture, object->start, object->size);
-	vm_remove_object(aperture, object);
+	/* GFX803_VA_REUSE_DEFER_PATCH: scratch-backing apertures must bypass the
+	 * defer FIFO. They are only torn down at shutdown by
+	 * fmm_release_scratch(), whose loop requires each released object to
+	 * leave the tree immediately -- a deferred (still-in-tree) object makes
+	 * that loop spin forever at process exit.
+	 */
+	if (fmm_is_scratch_aperture(object->start) == aperture) {
+		aperture_release_area(aperture, object->start, object->size);
+		vm_remove_object(aperture, object);
+	} else {
+		/* BOs are gone but the object stays in the tree on the defer
+		 * FIFO. Scrub the handle table first, so any stale handle
+		 * lookup/re-release through it is a no-op (see the
+		 * object->deferred guard above).
+		 */
+		for (i = 0; i < object->handle_num; i++)
+			object->handles[i] = 0;
+		object->deferred = true;
+		fmm_defer_release(aperture, object);
+	}
+
+	pthread_mutex_unlock(&aperture->fmm_mutex);
+	return 0;
 
 err_free_mem_failed:
 	pthread_mutex_unlock(&aperture->fmm_mutex);
