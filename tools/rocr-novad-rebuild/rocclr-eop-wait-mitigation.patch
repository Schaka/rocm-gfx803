+// gfx7/8 EOP-completion erratum mitigation -- see the WHY comment in
+// rocr-runtime's amd_blit_kernel.cpp for the full story (same underlying
+// hardware issue: an AQL dispatch's completion notification can be lost
+// even though the GPU genuinely finished the work). This is the shared
+// signal-wait helper behind HIP memcpy (hipMemcpyWithStream et al.) and
+// other ROCclr dispatch waits on gfx8 -- unlike the narrower rocr-runtime
+// fixes, there's no size/duration context here to auto-pick a safe
+// timeout, so this stays off by default and opt-in via
+// ROCR_GFX8_EOP_MITIGATION=1 (shared master switch with the rocr-runtime
+// side). ROCR_GFX8_EOP_MITIGATION_HIP_TIMEOUT_US (default 5000, i.e. 5ms)
+// needs to comfortably exceed your workload's genuinely slowest
+// individual dispatch through this path -- tune it up if you have long-
+// running kernels, since this function is shared with real kernel-
+// dispatch completion waits, not just small copies. On timeout this
+// returns true (proceed) exactly the way this function already does for
+// a device reported unstable below -- callers already treat that return
+// value as normal completion, so this doesn't change any caller
+// contract, and every test this session where that path fired still
+// produced correct output: the GPU had genuinely finished, software just
+// never observed it.
+static bool Gfx8EopMitigationEnabled() {
+  static const bool enabled = (getenv("ROCR_GFX8_EOP_MITIGATION") != nullptr);
+  return enabled;
+}
+
+static uint64_t Gfx8EopMitigationHipTimeoutUs() {
+  static const uint64_t v = []() -> uint64_t {
+    const char* env = getenv("ROCR_GFX8_EOP_MITIGATION_HIP_TIMEOUT_US");
+    return env ? uint64_t(atoll(env)) : 5000ull;
+  }();
+  return v;
+}
